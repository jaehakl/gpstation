# Copy this file to app_v1/slaves/ai/.env and adjust local model paths.
# Relative paths are resolved from app_v1/slaves/ai.

# Optional explicit GGUF model path. If blank, the built-in LLM repo/filename defaults are used.
LLM_MODEL_PATH=
LLM_USE_MAX_GPU=true
# Pass Qwen chat-template enable_thinking=false by default when the model template supports it.
LLM_ENABLE_THINKING=false
# LLM context window passed to llama.cpp n_ctx. Increase only if the model and hardware can handle it.
LLM_CONTEXT_SIZE=4096
# Multi-GPU llama.cpp options. Use CUDA_VISIBLE_DEVICES=0,1 if the process should see two GPUs.
# Stable 2-GPU split: LLM_SPLIT_MODE=layer and LLM_TENSOR_SPLIT=1,1.
# Tensor split can be useful on NVLink machines, but keep it experimental.
# Long context should usually start around LLM_CONTEXT_SIZE=32768, then try 49152 and 65536.
# Single GPU: LLM_SPLIT_MODE=none and LLM_MAIN_GPU=0
LLM_SPLIT_MODE=layer
LLM_TENSOR_SPLIT=
LLM_MAIN_GPU=0
# Long-context llama.cpp memory options. If llama_context creation fails, first lower
# LLM_CONTEXT_SIZE; then try lower LLM_N_BATCH/LLM_N_UBATCH values such as 256.
LLM_FLASH_ATTN=true
LLM_SWA_FULL=false
LLM_N_BATCH=512
LLM_N_UBATCH=512
LLM_OFFLOAD_KQV=true

# Required for ai.sdxl.t2i.
SDXL_CKPT_PATH=replace-with-sdxl-checkpoint.safetensors

# Required for ai.embeddings. EMBEDDING_MODEL_NAME takes precedence.
# Remote models require an immutable 40-character commit SHA and are loaded from
# the local Hugging Face cache by default. Temporarily set LOCAL_FILES_ONLY=false
# only while populating a trusted snapshot, then restore offline mode.
EMBEDDING_MODEL_NAME=
EMBEDDING_MODEL_PATH=
EMBEDDING_MODEL_REVISION=
EMBEDDING_LOCAL_FILES_ONLY=true

# Optional. Install the CPU runtime with: poetry run python scripts/install_voicevox.py
# Relative paths are resolved from app_v1/slaves/ai.
VOICEVOX_RUNTIME_DIR=voicevox_runtime
# 0 lets VOICEVOX Core choose the CPU thread count automatically.
VOICEVOX_CPU_NUM_THREADS=0
