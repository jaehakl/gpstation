# Production API base. The launcher connects to /v1/launchers/control.
GPSTATION_V1_API_URL=https://gps.qutat.com

# Create this in the website with the "launcher" scope.
GPSTATION_V1_ACCESS_TOKEN=replace-with-launcher-scope-access-token

# GPSTATION_V1_LAUNCHER_NAME=
GPSTATION_V1_HEARTBEAT_INTERVAL_SECONDS=5
GPSTATION_V1_WORKER_READY_TIMEOUT_SECONDS=10

# WebRTC ICE servers passed to slave subprocesses.
# STUN improves cross-network peer discovery. Some NAT/firewall combinations still require TURN.
GPSTATION_V1_RTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
# GPSTATION_V1_RTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"password"}]

# Shortens aiortc/aioice's non-trickle ICE gather wait for STUN-only setups.
# Increase to 2.0 or 3.0 if srflx candidates disappear on slower networks.
GPSTATION_V1_RTC_ICE_GATHER_TIMEOUT_SECONDS=1.0

# Keeps one live pre-gathered WebRTC peer in each worker subprocess for the next job.
# GPSTATION_V1_RTC_MEMORY_CACHE_ENABLED=true
