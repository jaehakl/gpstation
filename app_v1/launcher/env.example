# Production API base. The launcher connects to /v1/launchers/control.
GPSTATION_V1_API_URL=https://gps.qutat.com

# Create this in the website with the "launcher" scope.
GPSTATION_V1_ACCESS_TOKEN=replace-with-launcher-scope-access-token

# GPSTATION_V1_LAUNCHER_NAME=
GPSTATION_V1_HEARTBEAT_INTERVAL_SECONDS=5
GPSTATION_V1_SESSION_READY_TIMEOUT_SECONDS=10
