# Production example for https://gps.qutat.com.
# Copy this file to app_v1/server/.env and replace every replace-with-* value.

# PostgreSQL async SQLAlchemy URL.
GPSTATION_V1_DB_URL=postgresql+asyncpg://gpstation:replace-with-db-password@127.0.0.1:5432/gpstation_v1

# FastAPI listens only on localhost; Nginx exposes it at https://gps.qutat.com.
GPSTATION_V1_HOST=127.0.0.1
GPSTATION_V1_PORT=8000
GPSTATION_V1_RELOAD=false
GPSTATION_V1_PUBLIC_BASE_URL=https://gps.qutat.com
GPSTATION_V1_APP_BASE_URL=https://gps.qutat.com

# Google OAuth web client.
# Google Cloud Console:
# - Authorized JavaScript origin: https://gps.qutat.com
# - Authorized redirect URI: https://gps.qutat.com/web/auth/google/callback
GPSTATION_V1_GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id.apps.googleusercontent.com
GPSTATION_V1_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GPSTATION_V1_GOOGLE_REDIRECT_URI=https://gps.qutat.com/web/auth/google/callback
GPSTATION_V1_GOOGLE_ID_TOKEN_CLOCK_SKEW_SECONDS=10
GPSTATION_V1_OAUTH_STATE_TTL_SECONDS=600

# Generate a high-entropy secret, for example:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GPSTATION_V1_JWT_SECRET=replace-with-random-jwt-secret-at-least-32-characters
GPSTATION_V1_JWT_ALG=HS256
GPSTATION_V1_ACCESS_TTL_SEC=1200
GPSTATION_V1_REFRESH_TTL_SEC=1209600

# Leave blank for a host-only cookie. Optional explicit value: gps.qutat.com
GPSTATION_V1_COOKIE_DOMAIN=
GPSTATION_V1_SECURE_COOKIES=true
GPSTATION_V1_SESSION_TTL_SECONDS=300
GPSTATION_V1_SESSION_READY_TIMEOUT_SECONDS=10
GPSTATION_V1_CLEANUP_INTERVAL_SECONDS=5
# Cookie-backed /web routes, including /web/crud, use this allowlist.
# Bearer-token /v1 routes have separate public CORS handling for browser SDK/master apps.
GPSTATION_V1_CORS_ORIGINS=https://gps.qutat.com
