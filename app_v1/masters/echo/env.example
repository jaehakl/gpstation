# API base. This can point to local server or production gps.qutat.com.
# The server allows /v1 browser CORS from any origin; the Access Token is the auth boundary.
NEXT_PUBLIC_GPSTATION_V1_API_URL=https://gps.qutat.com

# Browser client token. Create this in the website with the "client" scope.
NEXT_PUBLIC_GPSTATION_V1_ACCESS_TOKEN=replace-with-client-scope-access-token

# Optional browser-side WebRTC ICE servers. Leave blank to use the SDK default STUN server.
NEXT_PUBLIC_GPSTATION_V1_RTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
# NEXT_PUBLIC_GPSTATION_V1_RTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"password"}]
