# API base. This can point to local server or production gps.qutat.com.
# The server allows /v1 browser CORS from any origin; the Access Token is the auth boundary.
VITE_GPSTATION_V1_API_URL=https://gps.qutat.com

# Enter a client-scope token at runtime. Tokens must never be embedded in Vite environment variables.

# Optional browser-side WebRTC ICE servers. Leave blank to use the SDK default STUN server.
VITE_GPSTATION_V1_RTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
# VITE_GPSTATION_V1_RTC_ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"password"}]
